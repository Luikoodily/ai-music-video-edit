# Copy to music-video/.env (gitignored). Never commit real keys.
# Loaded automatically by: python cli.py plan / run
#
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Optional comma-separated fallbacks (tried after primary + one retry):
# OPENROUTER_FALLBACK_MODELS=
#
# TEST ONLY — never set in production runs:
# MV_MOCK_PLANNER=1
